# Database
DATABASE_URL=postgresql://user:password@localhost:5432/settliq
# In production, set this to the PEM-encoded CA certificate of your managed
# PostgreSQL provider (e.g. AWS RDS, Supabase, Railway) to enable strict
# TLS certificate verification (rejectUnauthorized: true).
DATABASE_CA=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Rate limiting (milliseconds / requests per window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# Stellar Horizon (defaults to public mainnet if not set)
STELLAR_HORIZON_URL=https://horizon.stellar.org

# App
NODE_ENV=development
PORT=3000

# CORS — comma-separated list of allowed origins (leave unset to allow all origins)
# CORS_ALLOWED_ORIGINS=https://dashboard.settliq.io,https://waitlist.settliq.io
